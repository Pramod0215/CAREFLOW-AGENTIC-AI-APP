# For local development only. Replace with a strong random secret before deployment.
CAREFLOW_TOKEN_SECRET=replace-with-a-random-secret
CAREFLOW_ENV=development
CAREFLOW_DATA_DIR=./backend/data

# Optional Hugging Face Inference Provider model gateway.
# Keep tokens on the backend; never put them in VITE_* frontend variables.
HF_TOKEN=
HF_MODEL=
HF_CHAT_URL=https://router.huggingface.co/v1/chat/completions
